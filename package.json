{
  "name": "@rejaul/react-native-rust",
  "version": "1.1.1",
  "description": "Generate Rust and native bindings from React Native TurboModule TypeScript interfaces.",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "metro.js",
    "README.md",
    "LICENSE",
    "CONTRIBUTING.md",
    "CODE_OF_CONDUCT.md"
  ],
  "bin": {
    "react-native-rust": "./dist/react-native-rust.js"
  },
  "scripts": {
    "build": "node scripts/build.js",
    "typecheck": "tsc",
    "lint": "eslint .",
    "prepublishOnly": "npm run typecheck && npm run build",
    "pretest": "npm run typecheck && npm run build",
    "test": "node --test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DeveloperRejaul/react-native-rust.git"
  },
  "keywords": [
    "react-native",
    "rust",
    "typescript",
    "turbomodule",
    "codegen",
    "cli",
    "ios",
    "android",
    "jsi",
    "cpp",
    "ffi"
  ],
  "author": "",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/DeveloperRejaul/react-native-rust/issues"
  },
  "homepage": "https://github.com/DeveloperRejaul/react-native-rust#readme",
  "dependencies": {
    "chokidar": "^3.6.0",
    "typescript": "^5.9.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^20.19.43",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript-eslint": "^8.71.0"
  }
}
